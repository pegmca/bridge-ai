{
  "listen": {
    "host": "127.0.0.1",
    "port": 8787,
    "serverApiKey": "OPTIONAL-set-this-to-require-a-key-on-incoming-requests"
  },
  "logOutgoingBody": false,
  "logIncomingHeaders": false,
  "sanitize": {
    "enabled": false,
    "rules": [
      {
        "find": "You are an AI agent powered by DeepSeek Harness",
        "replace": "You are an AI agent"
      },
      {
        "find": "DeepSeek Harness",
        "replace": "Agent Harness"
      }
    ]
  },
  "autoRecapture": true,
  "provider": {
    "protocol": "codebuddy-native",
    "hosts": ["wb.tencentbuddy.com", "copilot.tencent.com"],
    "path": "/v2/chat/completions",
    "authHeader": "Authorization",
    "authScheme": "Bearer",
    "identity": { "X-Product": "SaaS", "X-Domain": "www.codebuddy.cn" },
    "channelVerifyRetries": 3,
    "timeout": 120000
  },
  "rotation": {
    "cooldownMs": 3600000
  },
  "accounts": [
    {
      "name": "cb-1",
      "auth": {
        "mode": "refresh",
        "refreshToken": "REPLACE_WITH_OFFLINE_REFRESH_TOKEN",
        "userId": "REPLACE_WITH_USER_ID"
      }
    }
  ]
}
