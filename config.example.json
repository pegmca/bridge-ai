{
  "listen": {
    "host": "127.0.0.1",
    "port": 8787,
    "serverApiKey": "auto"
  },
  "logOutgoingBody": false,
  "logIncomingHeaders": false,
  "usage": {
    "enabled": true,
    "dir": "./data/usage",
    "retainDays": 90
  },
  "sanitize": {
    "enabled": false,
    "rules": [
      {
        "find": "You are an AI agent powered by DeepSeek Harness",
        "replace": "You are an AI agent"
      },
      {
        "find": "DeepSeek Harness",
        "replace": "Agent Harness"
      }
    ]
  },
  "autoRecapture": true,
  "provider": {
    "protocol": "codebuddy-native",
    "hosts": ["wb.tencentbuddy.com", "copilot.tencent.com"],
    "path": "/v2/chat/completions",
    "authHeader": "Authorization",
    "authScheme": "Bearer",
    "identity": { "X-Product": "SaaS", "X-Domain": "www.codebuddy.cn" },
    "channelVerifyRetries": 3,
    "sessionMode": "prefix",
    "timeout": 120000,
    "models": [
      "hy4-preview",
      "hy3",
      "hy3-x",
      "step-5-preview",
      "space-bunny",
      "deepseek-v4.1-flash",
      "glm-5.3",
      "glm-5.3-flash",
      "glm-5.2",
      "glm-5.1",
      "glm-5v-turbo",
      "minimax-m3.1-flash",
      "minimax-m3",
      "minimax-m2.7",
      "kimi-k3.1-pro",
      "kimi-k3-1",
      "kimi-k2.8-preview",
      "deepseek-v4-pro",
      "mimo-v2.6-pro"
    ],
    "modelsOwner": "codebuddy"
  },
  "rotation": {
    "mode": "sticky",
    "cooldownMs": 3600000,
    "errorCooldownMs": 60000
  },
  "accountSource": {
    "type": "wb-switch",
    "path": "~/.wb-switch/accounts.json",
    "variants": ["cn"]
  },
  "accounts": []
}
